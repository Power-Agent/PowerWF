# Required: insert your own key before starting the application.
OPENAI_API_KEY=replace_with_your_own_api_key
B2G_MODEL=gpt-6-luna
B2G_REASONING_EFFORT=none
# Maximum output tokens for EACH LLM call, including revision calls.
B2G_MAX_OUTPUT_TOKENS=9000
# No cumulative task limit; input tokens do not reduce the per-call allowance.
B2G_MAX_TOTAL_TOKENS_PER_TASK=
# Bounded revisions within one interaction; not additional sender turns.
B2G_MAX_AGENT_REVISIONS=4
B2G_MAX_SCHEMA_REPAIRS=2
B2G_LLM_ENABLED=true
B2G_REQUIRE_LLM=true
B2G_LLM_MODE=offline
B2G_LLM_RECORD_ROOT=.local-runs/llm_records/gpt-6-luna
# UI configuration and all personal outputs are independent of formal runs.
# Paths are resolved relative to the repository; the default is outside its Git root.
B2G_PERSONAL_ROOT=../Personal-workspace

# Formal case and local-only data cache. Public code must not contain a
# workstation-specific value; set this in your untracked .env.
B2G_CASE_ID=ieee33_10bem_15min
B2G_DATA_ROOT=.local-data

# Formal physics backend. There is no surrogate demo backend.
B2G_SIMULATION_BACKEND=energyplus-pandapower

# Required only for the real EnergyPlus + pandapower backend.
B2G_ENERGYPLUS_EXE=replace_with_energyplus_executable_path
B2G_ENERGYPLUS_TIMEOUT_SECONDS=900
B2G_SIMULATION_OUTPUT_ROOT=.local-runs/simulations
# Fallback for direct library calls. UI and formal runners set their own roots.
B2G_JOURNAL_ROOT=outputs/interactions

# Use the repository-relative frozen source network by default.
B2G_PANDAPOWER_NETWORK=cases/ieee33_10bem_15min/network/study_network.json
B2G_PANDAPOWER_POWER_FACTOR=0.95

# Never commit your populated .env file.
